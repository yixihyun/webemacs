{
  "name": "webemacs-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:backend\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:backend": "node --watch backend/server.mjs",
    "build": "tsc -b && vite build",
    "start": "node backend/server.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@replit/codemirror-vim": "^6.2.1",
    "codemirror": "^6.0.1",
    "express": "^5.1.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/express": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
